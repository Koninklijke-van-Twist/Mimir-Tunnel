# Kopieer naar .env en vul de secrets in. Nooit committen.
# systemd EnvironmentFile: geen aanhalingstekens, geen spaties rond =.

# --- Bridge (deze service) ---
# Verplicht. Minimaal 16 tekens. Alleen via Authorization: Bearer. Nooit loggen.
TUNNEL_TOKEN=vervang-dit-door-een-lang-random-token

# Alleen 127.0.0.1. Poort waarop Mímir met curl praat.
TUNNEL_PORT=8787

# Aantal ingelogde BC-sessies. Praktisch 1 request tegelijk per sessie.
# Aanbevolen 1 of 2 (elke sessie is een aparte login, 4–5 s).
TUNNEL_POOL_SIZE=1

# true: muterende tools toegestaan. false: bridge weigert ze.
# Mímir beslist per API-key of een client mag schrijven; de bridge vertrouwt Mímir.
TUNNEL_ALLOW_WRITE=true

# Alleen actief als deze variabele een niet-lege waarde heeft.
# Kommagescheiden toolnamen. Weglaten = alle tools (behalve muterend als ALLOW_WRITE=false).
# TUNNEL_TOOL_ALLOWLIST=bc_list_companies,bc_open_page,bc_read_data,bc_close_page,bc_switch_company,bc_search_pages,bc_navigate,bc_lookup,bc_get_operation

TUNNEL_CALL_TIMEOUT_MS=120000
TUNNEL_QUEUE_TIMEOUT_MS=180000
# Upload via bc_upload_file (base64) kan groot zijn.
TUNNEL_BODY_LIMIT_BYTES=12582912

LOG_LEVEL=info

# --- Business Central (doorgegeven aan business-central-mcp, niet gelogd) ---
BC_BASE_URL=https://kvtmd365.kvt.nl/KVTMDLive_NUP
BC_AUTH=NavUserPassword
BC_TENANT_ID=default
BC_USERNAME=
BC_PASSWORD=
BC_SERVER_MAJOR=26
BC_CLIENT_VERSION=26.3.0.0
# Optioneel. De webclient-sessie wisselt van bedrijf via ?company= of bc_switch_company.
# BC_ODATA_COMPANY=Koninklijke van Twist

# 0 voorkomt dat het pakket zelf opnieuw inlogt bij een fout (account lockout).
# De bridge start bij een dode sessie zelf een nieuw proces.
BC_RECONNECT_MAX_RETRIES=0
